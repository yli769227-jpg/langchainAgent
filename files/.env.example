# 运行时可选配置。API Key / Base URL 从前端 UI 传入，**不**走这里。

# 前端登录密码（默认 agent2024，生产请务必改掉）
AGENT_LOGIN_PASSWORD=agent2024

# 仅当你的中转服务使用自签 SSL 证书时，才开启下面这项（生产不推荐）：
# AGENT_INSECURE_SSL=1

# ─────────────────────────────────────────────────────────────
# LangSmith trace (可选)
# 启用后，所有 agent 调用会上报到 LangSmith,带 session_id / endpoint / model tag。
# 缺少 LANGSMITH_API_KEY 或 LANGSMITH_TRACING=true 时静默不上报，不影响业务。
# 注册: https://smith.langchain.com/  →  Settings → API Keys
# ─────────────────────────────────────────────────────────────
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_pt_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LANGSMITH_PROJECT=langchainAgent-dev
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ─────────────────────────────────────────────────────────────
# Langfuse trace (可选,与 LangSmith 互相独立,可单独开/同时开)
# 启用后,LangChain CallbackHandler 会把每次 invoke 上报到 Langfuse。
# 同时配齐 PUBLIC_KEY + SECRET_KEY 才启用,缺任一即静默跳过,不影响业务。
# Langfuse Cloud 注册: https://cloud.langfuse.com/  →  Project Settings → API Keys
# 自部署只需把 LANGFUSE_HOST 指到自己的实例。
# ─────────────────────────────────────────────────────────────
# LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
# LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx
# LANGFUSE_HOST=https://cloud.langfuse.com
